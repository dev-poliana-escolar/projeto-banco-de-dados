mysql> SELECT 
    ->     c.cli_nome,
    ->     p.pro_nome,
    ->     iv.it_quantidade,
    ->     iv.it_valor_total
    -> FROM tb_itens_vendidos iv
    -> JOIN tb_produto p ON iv.it_pro_codigo = p.pro_codigo
    -> JOIN tb_venda v ON iv.it_ven_codigo = v.ven_codigo
    -> JOIN tb_cliente c ON v.ven_cli_codigo = c.cli_codigo;

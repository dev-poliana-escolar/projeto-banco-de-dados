mysql> SELECT 
    ->     p.pro_nome,
    ->     SUM(pp.pp_quantidade) AS total_produzido
    -> FROM tb_producao_produto pp
    -> JOIN tb_produto p ON pp.pp_pro_codigo = p.pro_codigo
    -> GROUP BY p.pro_nome
    -> HAVING SUM(pp.pp_quantidade) > 100;
+----------+-----------------+
| pro_nome | total_produzido |
+----------+-----------------+
| Goma     |            5100 |
+----------+-----------------+
1 row in set (0.01 sec)

mysql> SELECT 
    ->     p.pro_nome,
    ->     SUM(pp.pp_quantidade) AS total_produzido
    -> FROM tb_producao_produto pp
    -> JOIN tb_produto p ON pp.pp_pro_codigo = p.pro_codigo
    -> GROUP BY p.pro_nome
    -> ORDER BY total_produzido DESC;
+----------+-----------------+
| pro_nome | total_produzido |
+----------+-----------------+
| Goma     |            5100 |
| Farinha  |              80 |
